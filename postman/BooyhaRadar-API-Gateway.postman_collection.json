      "id": "b00b0000-0000-4000-8000-000000000001",
      "name": "Auth - Identity Service",
      "description": "Registro, inicio de sesión y administración de usuarios. Los cuatro requests de /usuarios requieren adminToken.",
      "item": [
        {
          "id": "b00b0000-0000-4000-8000-000000000002",
          "name": "POST - Registrar jugador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authBase}}/auth/register",
            "description": "Crea una cuenta de jugador y guarda usuarioId para el perfil.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{playerEmail}}\",\n  \"password\": \"{{playerPassword}}\",\n  \"rol\": \"PLAYER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"playerEmail\", \"player.\" + Date.now() + \"@booyharadar.test\");",
                  "pm.collectionVariables.set(\"playerPassword\", \"PlayerTest123!\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.expect(data.rol).to.eql(\"PLAYER\");",
                  "pm.collectionVariables.set(\"playerUserId\", data.usuarioId);"
                ]
              }
            }
          ]
        },
        {
          "id": "b00b0000-0000-4000-8000-000000000003",
